          "default": null,
          "title": "Query"
        },
        "sender_phone_number": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sender Phone Number"
        }
      },
      "title": "list_messagesArguments",
      "type": "object"
    },
