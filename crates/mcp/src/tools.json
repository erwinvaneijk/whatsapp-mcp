            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reply To Message Id"
        },
        "reply_to_sender_jid": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reply To Sender Jid"
        }
      },
      "required": [
        "recipient",
        "message"
      ],
      "title": "send_messageArguments",
      "type": "object"
    },
    "name": "send_message",
    "outputSchema": {
      "additionalProperties": true,
