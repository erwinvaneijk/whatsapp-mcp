        "chat_jid": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Chat Jid"
        },
        "context_after": {
          "default": 1,
          "title": "Context After",
          "type": "integer"
        },
        "context_before": {
          "default": 1,
          "title": "Context Before",
          "type": "integer"
        },
        "include_context": {
          "default": true,
          "title": "Include Context",
          "type": "boolean"
        },
        "limit": {
          "default": 20,
          "title": "Limit",
          "type": "integer"
        },
        "page": {
          "default": 0,
          "title": "Page",
          "type": "integer"
        },
        "query": {
          "anyOf": [
            {
              "type": "string"
            },
            {
