  {
    "annotations": {
      "destructiveHint": true,
      "idempotentHint": false,
      "openWorldHint": true,
      "readOnlyHint": false,
      "title": "Send Message"
    },
    "description": "Send a WhatsApp message to a person or group. For group chats use the JID.\n\n    Args:\n        recipient: The recipient - either a phone number with country code but no + or other symbols,\n                 or a JID (e.g., \"123456789@s.whatsapp.net\" or a group JID like \"123456789@g.us\")\n        message: The message text to send\n        reply_to_message_id: Optional message id to quote-reply to. The id can be obtained\n                 from list_messages or get_message_context (the `id` field). Passing this\n                 makes the outbound message appear as a reply in the recipient's chat.\n        reply_to_sender_jid: JID of the original message's sender. Required for group\n                 replies (WhatsApp needs to know whose message you're quoting); optional\n                 for direct chats.\n        mentions: Optional list of people to @mention, as phone numbers (country code, no +)\n                 or JIDs. Also put \"@<number>\" for each of them in the message text,\n                 otherwise WhatsApp does not highlight the mention.\n\n    Returns:\n        A dictionary containing success status and a status message\n    ",
    "inputSchema": {
      "properties": {
        "mentions": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mentions"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "recipient": {
          "title": "Recipient",
          "type": "string"
        },
